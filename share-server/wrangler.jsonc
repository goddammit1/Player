{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "player-share-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "kv_namespaces": [
    // Локально (wrangler dev / тесты) id не важен: KV эмулирует Miniflare.
    // Перед деплоем заменить на id из `wrangler kv namespace create PLAYLISTS`.
    { "binding": "PLAYLISTS", "id": "local-playlists" }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    // Пусто — ссылки строятся от origin запроса (удобно для локальной сети).
    "PUBLIC_BASE_URL": "",
    "DOWNLOAD_URL": "https://github.com/goddammit1/Player/releases/latest"
  }
}
