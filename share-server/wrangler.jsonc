{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "player-share-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "kv_namespaces": [
    // Боевой namespace (`wrangler kv namespace create PLAYLISTS`). Локально
    // (wrangler dev / тесты) Miniflare эмулирует KV и этот id не трогает.
    { "binding": "PLAYLISTS", "id": "5497ba7a4b254760b848e657b641479a" }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    // Пусто — ссылки строятся от origin запроса (удобно для локальной сети).
    "PUBLIC_BASE_URL": "",
    "DOWNLOAD_URL": "https://github.com/goddammit1/Player/releases/latest"
  }
}
