<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Отдельная подпись в лаунчере, чтобы debug (com.player.player.debug)
         не путался с установленным рядом релизом. -->
    <application
        android:label="Player Debug"
        tools:replace="android:label">
        <!-- Soulseek AAR (.NET/Mono) объявляет провайдер с фиксированным
             authority — без переопределения debug не встаёт рядом с релизом
             (INSTALL_FAILED_CONFLICTING_PROVIDER). -->
        <provider
            android:name="mono.MonoRuntimeProvider"
            android:authorities="${applicationId}.mono.MonoRuntimeProvider.__mono_init__"
            tools:replace="android:authorities"/>
    </application>
</manifest>
